# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Dashboard → API Keys)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secret for rider handover codes and review links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HANDOVER_SECRET=

# WhatsApp Business Cloud API (optional — leave empty to use click-to-chat only)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en

# Search engines — verification codes from Google Search Console / Bing Webmaster Tools
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google AdSense (ads load only after the visitor clicks "Accept all")
# Publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit id shown inside Style Journal articles
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# Business contact
NEXT_PUBLIC_BUSINESS_PHONE=+92 300 0000000
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000

# Payment accounts shown on the payment step (manual transfer + slip upload)
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_JAZZCASH=
NEXT_PUBLIC_EASYPAISA=
NEXT_PUBLIC_RAAST_ID=
