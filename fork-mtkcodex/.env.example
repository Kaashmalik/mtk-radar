# Copy to .env.local for local development. In production paste the same file into
# Netlify → Project configuration → Environment variables → "Import from a .env file".
# Full guide: docs/CRM.md → "Go-live checklist" (Step 0 covers Netlify and the domain).

# --- Required -----------------------------------------------------------------
# Admin login (/admin)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# 32+ random bytes (openssl rand -hex 32). Also keys analytics hashing and chat resume links.
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=https://mtkcodex.tech

# Database (Supabase). Run supabase/migrations/0001…0004 in order first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend: sending + receiving into the inbox) --------------------------
RESEND_API_KEY=
EMAIL_FROM="Kashif at MTK Codex <hello@mtkcodex.tech>"
CONTACT_TO_EMAIL=you@example.com
# Receiving: MX record from Resend + email.received webhook → /api/email/webhook
EMAIL_REPLY_DOMAIN=mtkcodex.tech
RESEND_WEBHOOK_SECRET=
# Optional: also forward every inbound email here
EMAIL_FORWARD_TO=

# --- Alerts on your phone / laptop -----------------------------------------------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional Telegram backup alerts (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Live chat & booking --------------------------------------------------------
# Name shown to visitors in the chat
CHAT_AGENT_NAME=Kashif
# Free Cal.com / Google appointment page for video calls
NEXT_PUBLIC_BOOKING_URL=

# --- WhatsApp Cloud API (optional; outreach desk works without it) --------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0

# --- Optional -------------------------------------------------------------------
# Private warehouse Google Sheet link shown in the admin
LEADS_SHEET_URL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Google Analytics 4 / AdSense (load only after consent)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
