{"name": "mtk-radar", "version": "0.12.0", "private": true, "scripts": {"dev": "docker compose -f infra/docker/docker-compose.yml up", "dev:workers": "docker compose -f infra/docker/docker-compose.yml --profile workers up", "setup": "pnpm install", "test": "pytest services/api/tests workers/verification/tests workers/render/tests workers/publishing/tests -v", "typecheck": "tsc --noEmit -p packages/offer-schema && tsc --noEmit -p apps/dashboard", "migrate": "python services/api/db_migrate.py", "backup": "bash infra/backup.sh", "seed:sources": "python services/api/scripts/seed_sources.py"}, "devDependencies": {"typescript": "^5.7.2"}}