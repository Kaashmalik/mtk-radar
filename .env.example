# Copy to .env (never commit .env itself).

# API
DATABASE_URL=postgresql://mtk:mtk@localhost:5432/mtk_radar
REDIS_URL=redis://localhost:6379/0
API_URL=http://localhost:8000
# Optional shared bearer token for the API (services/api/api_hardening.py).
# Leave unset for local dev; set it for ANY deployment beyond localhost.
# Must be URL-safe/random (e.g. `openssl rand -hex 32`). Workers and the
# extension send: Authorization: Bearer <token>
# v0.16: the browser must never hold the master secret. The dashboard's
# server-side reads may use MTK_API_TOKEN (Node-only, not shipped to the
# client); interactive actions authenticate with personal reviewer tokens
# instead:   python -m scripts.mint_reviewer --name <name>   (from services/api/)
# and paste one in the dashboard's identity box. NEXT_PUBLIC_API_TOKEN was
# removed — do not reintroduce it.
# MTK_API_TOKEN=

# Fetch provenance signing (WP01, v0.21+). The verification worker signs the
# provenance of every machine-collected snapshot with this key; the API refuses
# unsigned machine evidence by default. A signature proves a holder of the key
# produced the record — not that the page was actually fetched.
# Generate once per deployment and share it ONLY with the verification worker:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# MTK_FETCH_SIGNING_KEY=
# Only for migrating a legacy deployment (unsigned records become storable and
# promotable again — the gap is explicit, not silent):
# MTK_REQUIRE_FETCH_SIGNATURE=1
# Every extraction from the acquisition worker records which snapshots it read
# and how many sections they split into; promotion refuses machine evidence
# without that record. Opt out only while migrating a legacy deployment:
# MTK_REQUIRE_EXTRACTION_COVERAGE=1
# Machine collection is refused for a source until a reviewer records that its
# terms permit automated reading (POST /sources/{id}/tos-review). robots.txt is
# checked separately. Opt out only while migrating a legacy deployment:
# MTK_REQUIRE_TOS_ATTESTATION=1
# A terms-of-service review expires after this many days (1..3650, default
# 180); an expired review stops new machine collection until it is re-recorded:
# MTK_TOS_REVIEW_TTL_DAYS=180

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# Publishing worker (week 10) — real values live ONLY in your env/vault.
# The DB stores credential REFERENCES (env prefixes / vault paths), never tokens.
# YouTube Data API (OAuth2 client + refresh token; test uploads go out private):
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# Meta Graph (long-lived Page token; test posts go out unpublished):
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# TikTok Content Posting API (needs an APPROVED developer app — week 11
# "as permissions allow"; test uploads default to SELF_ONLY):
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REFRESH_TOKEN=
# Instagram Graph publishing (v0.19) — needs an Instagram PROFESSIONAL account
# bound to a Facebook Page, and a PUBLIC https URL for the media (the Graph
# API fetches the video itself, it does not accept an upload):
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# Public origin of the object store (CDN / public bucket) used to build that
# media URL — v0.19, required for Instagram-style publishing:
# MTK_PUBLIC_MEDIA_BASE_URL=https://cdn.example.com

# Secrets belong in a vault/env manager — put NOTHING real in this file.
# LLM extraction keys, platform OAuth tokens, and object-storage credentials
# are added per-environment at deploy time (master plan §7).

# Object storage (v0.15) — where capture videos, renders, and captions live.
# Unset MTK_STORAGE_BACKEND → legacy single-host relative paths.
#   local → files under MTK_STORAGE_LOCAL_ROOT; refs are local://<key>.
#   s3    → any S3-compatible store (MinIO/AWS/R2/B2); refs are s3://<bucket>/<key>.
# When running the storage profile in compose: MTK_S3_ENDPOINT=http://minio:9000
# MTK_STORAGE_BACKEND=
# MTK_STORAGE_LOCAL_ROOT=./storage
# MTK_S3_ENDPOINT=
# MTK_S3_BUCKET=mtk-radar
# MTK_S3_ACCESS_KEY=
# MTK_S3_SECRET_KEY=
# MTK_S3_REGION=us-east-1

# Publishing auto-retry (v0.17, §17): failed posts requeue with exponential
# backoff (base × 2^attempts); posts past the cap wait for operator review.
# MTK_PUBLISH_MAX_RETRIES=3
# MTK_PUBLISH_RETRY_BASE_S=300

# Measured render QC (v0.29). Only status=rendered + qc_status=passed may be
# scheduled or published. Defaults target social delivery: -16 LUFS ±1 LU,
# true peak ≤ -1 dBTP, H.264/AAC, no unexplained black/freeze/silence.
# See docs/render-qc.md before relaxing any value for a specific account.
# MTK_RENDER_QC_TARGET_LUFS=-16
# MTK_RENDER_QC_LUFS_TOLERANCE=1
# MTK_RENDER_QC_MAX_TRUE_PEAK=-1
# MTK_RENDER_QC_REQUIRE_AUDIO=1
# MTK_RENDER_QC_MIN_VIDEO_BPS=250000
# MTK_RENDER_QC_MIN_AUDIO_BPS=64000
# MTK_RENDER_QC_DURATION_TOLERANCE_S=0.5
# MTK_RENDER_QC_DURATION_TOLERANCE_RATIO=0.01
# MTK_RENDER_QC_MAX_BLACK_S=1
# MTK_RENDER_QC_MAX_FREEZE_S=5
# MTK_RENDER_QC_MAX_SILENCE_S=2
# MTK_RENDER_QC_BLACK_PIXEL_THRESHOLD=0.10
# MTK_RENDER_QC_FREEZE_NOISE=0.003
# MTK_RENDER_QC_SILENCE_NOISE_DB=-50
# MTK_RENDER_QC_PROBE_TIMEOUT_S=30
# MTK_RENDER_QC_DECODE_TIMEOUT_S=300
# MTK_RENDER_QC_CAPTION_SAFE_FRACTION=0.03
# MTK_RENDER_QC_CAPTION_MAX_LINES=3
# Intentional stills/official pages: JSON list of {start,end,reason} in seconds.
# Script metadata can also carry "qc_exempt_ranges" for a specific offer.
# MTK_RENDER_QC_EXEMPT_RANGES=[]

# Audience-metrics sweep cadence, seconds (v0.18) — one daily snapshot per
# post is kept by the API; the interval only controls politeness.
# MTK_METRICS_INTERVAL=3600

# Batch worker cadence, seconds (v0.19) — generates scripts for earned
# offers and reports pipeline readiness.
# MTK_BATCH_INTERVAL=900

# Public origin of the dashboard (v0.17) — when set, scheduled captions carry
# a correction permalink: <origin>/offers/<id> (master plan §11). It is also
# added to the API's CORS allowlist automatically.
# MTK_PUBLIC_BASE_URL=

# Browser origins allowed to call the API (comma separated). Defaults to the
# local dashboard origins; add your deployed dashboard origin here (v0.20).
# MTK_CORS_ORIGINS=https://radar.yourdomain.tld

# Monitor notifications (optional). The monitor always logs alerts; these
# settings add an outbound webhook and/or an SMTP email digest. See
# docs/notifications.md. Leave both channels blank to keep logging only.
#
# Outbound webhook: JSON POST, schema mtk-radar.notification.v1. The token is
# sent as "Authorization: Bearer <token>"; use a long random value and verify
# it in your receiver (or rely on a secret webhook URL).
# MTK_NOTIFY_WEBHOOK_URL=
# MTK_NOTIFY_WEBHOOK_TOKEN=
#
# Email digest over SMTP. For Gmail use an App Password (2-Step Verification
# required), not your normal account password. Port 587 uses STARTTLS; port
# 465 uses implicit SSL automatically.
# MTK_NOTIFY_EMAIL_TO=
# MTK_SMTP_HOST=smtp.gmail.com
# MTK_SMTP_PORT=587
# MTK_SMTP_USER=
# MTK_SMTP_PASSWORD=
# MTK_SMTP_FROM=
# MTK_SMTP_STARTTLS=1
# MTK_SMTP_SSL=0
# MTK_NOTIFY_TIMEOUT_S=10
# Suppress an identical alert digest for this many seconds after successful
# delivery (default 1 hour); 0 disables the cooldown. Cooldown is in-memory.
# MTK_NOTIFY_COOLDOWN_S=3600
# MTK_NOTIFY_SUBJECT_PREFIX=[MTK RADAR]
