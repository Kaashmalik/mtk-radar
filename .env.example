# Copy to .env (never commit .env itself).

# API
DATABASE_URL=postgresql://mtk:mtk@localhost:5432/mtk_radar
REDIS_URL=redis://localhost:6379/0
API_URL=http://localhost:8000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# Publishing worker (week 10) — real values live ONLY in your env/vault.
# The DB stores credential REFERENCES (env prefixes / vault paths), never tokens.
# YouTube Data API (OAuth2 client + refresh token; test uploads go out private):
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# Meta Graph (long-lived Page token; test posts go out unpublished):
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# TikTok Content Posting API (needs an APPROVED developer app — week 11
# "as permissions allow"; test uploads default to SELF_ONLY):
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REFRESH_TOKEN=

# Secrets belong in a vault/env manager — put NOTHING real in this file.
# LLM extraction keys, platform OAuth tokens, and object-storage credentials
# are added per-environment at deploy time (master plan §7).
