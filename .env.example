# Copy to .env (never commit .env itself).

# API
DATABASE_URL=postgresql://mtk:mtk@localhost:5432/mtk_radar
REDIS_URL=redis://localhost:6379/0
API_URL=http://localhost:8000
# Bearer credentials (services/api/api_hardening.py). Leave all unset only for
# local development; set them for ANY deployment beyond localhost.
#   MTK_API_TOKEN       service credential used by the dashboard server
#   MTK_WORKER_TOKEN    workers (falls back to the service token when unset)
#   MTK_EXTENSION_TOKEN browser extension (optional)
# Each must be URL-safe/random (`openssl rand -hex 32`). Non-human credentials
# may only name an explicit automation:<stage> or system: actor; they can NEVER
# approve, attest ToS, review redaction, or correct an offer as a human.
# MTK_API_TOKEN=
# MTK_WORKER_TOKEN=
# MTK_EXTENSION_TOKEN=
#
# Humans sign in to the dashboard with a personal reviewer token:
#   python -m scripts.mint_reviewer --name <name>   (from services/api/)
# The token is exchanged for a signed HttpOnly cookie; browser JavaScript never
# reads it. NEXT_PUBLIC_API_TOKEN was removed — do not reintroduce it.

# Fetch provenance signing (WP01, v0.21+). The verification worker signs the
# provenance of every machine-collected snapshot with this key; the API refuses
# unsigned machine evidence by default. A signature proves a holder of the key
# produced the record — not that the page was actually fetched.
# Generate once per deployment and share it ONLY with the verification worker:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# MTK_FETCH_SIGNING_KEY=
# Only for migrating a legacy deployment (unsigned records become storable and
# promotable again — the gap is explicit, not silent):
# MTK_REQUIRE_FETCH_SIGNATURE=1
# Every extraction from the acquisition worker records which snapshots it read
# and how many sections they split into; promotion refuses machine evidence
# without that record. Opt out only while migrating a legacy deployment:
# MTK_REQUIRE_EXTRACTION_COVERAGE=1
# Machine collection is refused for a source until a reviewer records that its
# terms permit automated reading (POST /sources/{id}/tos-review). robots.txt is
# checked separately. Opt out only while migrating a legacy deployment:
# MTK_REQUIRE_TOS_ATTESTATION=1
# A terms-of-service review expires after this many days (1..3650, default
# 180); an expired review stops new machine collection until it is re-recorded:
# MTK_TOS_REVIEW_TTL_DAYS=180

# Dashboard (server-side only; do not prefix these with NEXT_PUBLIC_).
# API_URL is the internal API origin used by server components, the login
# exchange and the same-origin /api/backend proxy.
# MTK_SESSION_SECRET signs the HttpOnly reviewer session cookie. It is REQUIRED
# for the dashboard to serve anything except the login page (fail closed); use
# at least 32 random characters: `openssl rand -hex 32`. Rotating it signs
# everyone out. Rotate the reviewer token itself if it may have leaked.
# API_URL=http://localhost:8000
# MTK_SESSION_SECRET=

# Publishing worker (week 10) — real values live ONLY in your env/vault.
# The DB stores credential REFERENCES (env prefixes / vault paths), never tokens.
# YouTube Data API (OAuth2 client + refresh token; test uploads go out private):
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# Meta Graph (long-lived Page token; test posts go out unpublished):
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# TikTok Content Posting API (needs an APPROVED developer app — week 11
# "as permissions allow"; test uploads default to SELF_ONLY):
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REFRESH_TOKEN=
# Set to 1 ONLY after TikTok approves (audits) the app. Unaudited clients may
# post SELF_ONLY; public TikTok posts are refused before upload until then.
# TIKTOK_APP_AUDITED=0
# Publishing circuit breaker: after N consecutive failures for one account its
# posts are skipped (left scheduled) for the cooldown, then one probe runs.
# MTK_PUBLISH_BREAKER_THRESHOLD=3
# MTK_PUBLISH_BREAKER_COOLDOWN_S=900
# Durable outbox for undeliverable cost telemetry + monitor notifications
# (replayed with backoff; mount it on a volume in containers to survive restarts).
# MTK_OUTBOX_DIR=~/.mtk-radar/outbox
# YouTube quota ledger (Q1). Copy the real numbers from your Google Cloud
# console (APIs & Services → YouTube Data API v3 → Quotas). Defaults are the
# long-documented conservative values so uploads never plan past the quota.
# API (limits per Pacific day; 0 disables a bucket):
# YOUTUBE_QUOTA_UNITS_PER_DAY=10000
# YOUTUBE_QUOTA_UPLOADS_PER_DAY=0
# Publishing worker (units per operation):
# YOUTUBE_QUOTA_COST_UPLOAD=1600
# YOUTUBE_QUOTA_COST_THUMBNAIL=50
# YOUTUBE_QUOTA_COST_CAPTIONS=400
# YOUTUBE_QUOTA_COST_PLAYLIST=50
# YOUTUBE_QUOTA_COST_COMMENT=50
# YOUTUBE_QUOTA_COST_STATUS_POLLS=60
# Instagram Graph publishing (v0.19) — needs an Instagram PROFESSIONAL account
# bound to a Facebook Page, and a PUBLIC https URL for the media (the Graph
# API fetches the video itself, it does not accept an upload):
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# Public origin of the object store (CDN / public bucket) used to build that
# media URL — v0.19, required for Instagram-style publishing:
# MTK_PUBLIC_MEDIA_BASE_URL=https://cdn.example.com

# ------------------------------------------------------------ robustness (WP-G)
# Token lifecycle: the publishing worker renews Facebook/Instagram long-lived
# tokens via Meta's fb_exchange_token grant on this cadence (expiry margin in
# days). Needs FACEBOOK_APP_ID/FACEBOOK_APP_SECRET (or INSTAGRAM_*/prefix
# variants). A refused exchange marks the account token_expired → Needs-You —
# never a silent stall. TikTok/YouTube refresh themselves in-flight already.
# MTK_TOKEN_REFRESH_CADENCE_D=45
# MTK_TOKEN_REFRESH_MARGIN_D=14
#
# Media retention: artifacts not pinned by a live schedule may be reclaimed
# after this many days (POST /media/gc, dry_run=true by default).
# MTK_MEDIA_RETENTION_DAYS=90
#
# LLM extraction hardening (§5.6.3): per-call timeout, bounded retries with
# backoff + jitter, and a hard request budget for ONE verification run (a
# large document can never turn into an unbounded spend).
# VERIFY_LLM_TIMEOUT_S=45
# VERIFY_LLM_MAX_ATTEMPTS=3
# VERIFY_LLM_MAX_CALLS_PER_RUN=12

# --------------------------------------------------------------- costs (WP-F)
# The usage ledger + budget gate (services/api/costs_*.py). Every money-cap
# is checked by the workers BEFORE spending; an exhausted budget degrades the
# stage (LLM extraction falls back to the deterministic rules path, TTS to
# capture audio) and shows in Settings → Costs and Needs-You — never a
# surprise bill.
#
# LLM extraction (optional; OpenAI-compatible endpoint; a local Ollama works:
#   VERIFY_LLM_BASE_URL=http://localhost:11434/v1 with any dummy API key).
# VERIFY_LLM_BASE_URL=
# VERIFY_LLM_API_KEY=
# VERIFY_LLM_MODEL=qwen2.5:7b        # probed on Settings → Costs (GET /models, /api/tags)
# Hard cap on one completion's output tokens (verification hardening §5.6.3):
# VERIFY_LLM_MAX_OUTPUT_TOKENS=2000
#
# TTS narration (optional; OpenAI-compatible /audio/speech; the open Kokoro
# FastAPI shim works with the same shape). Language overrides exist:
#   TTS_BASE_URL_UR / TTS_API_KEY_UR / TTS_MODEL_UR / TTS_VOICE_UR
# TTS_BASE_URL=
# TTS_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICE=onyx
# TTS_BASE_URL_UR=
# TTS_API_KEY_UR=
# TTS_MODEL_UR=
# TTS_VOICE_UR=
# Free self-hosted narration (no per-character bill): run an OpenAI-compatible
# TTS server such as Kokoro-FastAPI or a Piper wrapper next to the render
# worker, point TTS_BASE_URL at it (e.g. http://localhost:8880/v1 or
# http://kokoro:8880/v1), leave TTS_API_KEY empty and set TTS_LOCAL=1. The flag
# is ignored for public hosts, so a paid API always stays budget-gated. Check
# each voice/model licence; English-first (do not assume Urdu support).
# TTS_LOCAL=0
# Render encode speed/size trade-off (medium | slow | veryslow).
# MTK_RENDER_X264_PRESET=medium

# Guided capture (host-side, workers/capture — not a compose service).
# ffmpeg = near-lossless screen recording of a kiosk browser at 1920x1080
# (sharp UI/code text); playwright (default) records only the page but at a
# low bitrate. A screen recorder sees everything in its region: keep other
# windows/notifications away. Redaction review stays mandatory either way.
# MTK_CAPTURE_BACKEND=playwright
# MTK_CAPTURE_FPS=30
# MTK_CAPTURE_CRF=12
# MTK_CAPTURE_OFFSET_X=0
# MTK_CAPTURE_OFFSET_Y=0
# MTK_CAPTURE_SCREEN_INDEX=1        # macOS avfoundation screen device
# MTK_CAPTURE_AUDIO_DEVICE=         # dshow name / pulse source; empty = no mic

# Meta app credentials (WP-G long-lived token refresh for Facebook/Instagram:
# the publishing worker renews page/IG tokens via fb_exchange_token). The
# INSTAGRAM_APP_ID/SECRET variants take precedence for Instagram.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
#
# Pricing for the cost ESTIMATES (USD per million). Estimates are displayed
# everywhere as estimates; set these to your provider's real prices.
# COST_LLM_INPUT_PER_MTOK=0.15
# COST_LLM_OUTPUT_PER_MTOK=0.60
# COST_TTS_PER_MCHAR=15.0
#
# THE ACTUAL CAPS live in Settings → Automation policy → guardrails:
#   max_llm_cost_per_day_usd  (default 0.50; 0 in the manual preset)
#   max_tts_chars_per_day     (default 50000;  0 in the manual preset)

# Secrets belong in a vault/env manager — put NOTHING real in this file.
# LLM extraction keys, platform OAuth tokens, and object-storage credentials
# are added per-environment at deploy time (master plan §7).

# Object storage (v0.15) — where capture videos, renders, and captions live.
# Unset MTK_STORAGE_BACKEND → legacy single-host relative paths.
#   local → files under MTK_STORAGE_LOCAL_ROOT; refs are local://<key>.
#   s3    → any S3-compatible store (MinIO/AWS/R2/B2); refs are s3://<bucket>/<key>.
# When running the storage profile in compose: MTK_S3_ENDPOINT=http://minio:9000
# MTK_STORAGE_BACKEND=
# MTK_STORAGE_LOCAL_ROOT=./storage
# MTK_S3_ENDPOINT=
# MTK_S3_BUCKET=mtk-radar
# MTK_S3_ACCESS_KEY=
# MTK_S3_SECRET_KEY=
# MTK_S3_REGION=us-east-1

# Publishing auto-retry (v0.17, §17): failed posts requeue with exponential
# backoff (base × 2^attempts); posts past the cap wait for operator review.
# MTK_PUBLISH_MAX_RETRIES=3
# MTK_PUBLISH_RETRY_BASE_S=300

# Measured render QC (v0.29). Only status=rendered + qc_status=passed may be
# scheduled or published. Defaults target social delivery: -16 LUFS ±1 LU,
# true peak ≤ -1 dBTP, H.264/AAC, no unexplained black/freeze/silence.
# See docs/render-qc.md before relaxing any value for a specific account.
# MTK_RENDER_QC_TARGET_LUFS=-16
# MTK_RENDER_QC_LUFS_TOLERANCE=1
# MTK_RENDER_QC_MAX_TRUE_PEAK=-1
# MTK_RENDER_QC_REQUIRE_AUDIO=1
# MTK_RENDER_QC_MIN_VIDEO_BPS=250000
# MTK_RENDER_QC_MIN_AUDIO_BPS=64000
# MTK_RENDER_QC_DURATION_TOLERANCE_S=0.5
# MTK_RENDER_QC_DURATION_TOLERANCE_RATIO=0.01
# MTK_RENDER_QC_MAX_BLACK_S=1
# MTK_RENDER_QC_MAX_FREEZE_S=5
# MTK_RENDER_QC_MAX_SILENCE_S=2
# MTK_RENDER_QC_BLACK_PIXEL_THRESHOLD=0.10
# MTK_RENDER_QC_FREEZE_NOISE=0.003
# MTK_RENDER_QC_SILENCE_NOISE_DB=-50
# MTK_RENDER_QC_PROBE_TIMEOUT_S=30
# MTK_RENDER_QC_DECODE_TIMEOUT_S=300
# MTK_RENDER_QC_CAPTION_SAFE_FRACTION=0.03
# MTK_RENDER_QC_CAPTION_MAX_LINES=3
# Intentional stills/official pages: JSON list of {start,end,reason} in seconds.
# Script metadata can also carry "qc_exempt_ranges" for a specific offer.
# MTK_RENDER_QC_EXEMPT_RANGES=[]

# Audience-metrics sweep cadence, seconds (v0.18) — one daily snapshot per
# post is kept by the API; the interval only controls politeness.
# MTK_METRICS_INTERVAL=3600

# Growth health composite (v0.31). OFF by default: YouTube's Developer
# Policies restrict replacing API data with independently calculated metrics
# without an approved compliance review. Raw measured fields and conservative
# recommendations remain available. Enable ONLY after that review is recorded.
# MTK_ENABLE_GROWTH_SCORE=0

# Worker heartbeats (v0.30). Long-running workers post to /workers/heartbeat;
# the dashboard and monitor alert on stale/missing beats. Set to 0 only for a
# deliberately single-shot/manual deployment where liveness matters less.
# MTK_WORKER_HEARTBEATS=1

# scripts/mtk-start.sh also starts the MinIO profile when this is 1.
# MTK_START_STORAGE=0

# Batch worker cadence, seconds (v0.19) — generates scripts for earned
# offers and reports pipeline readiness.
# MTK_BATCH_INTERVAL=900

# Trend-signal collectors (v0.34, WP-A). The HF Papers / HN / Reddit /
# Google Trends adapters cache raw payloads so repeated sweeps never double
# the API traffic. Set REDIS_URL to share that cache across restarts (the
# collector also runs fine without Redis — in-process memory cache only).
# GITHUB_TOKEN also lifts rate limits for the github_releases and
# github_stars adapters (official REST, 60 req/h unauthenticated).
# GITHUB_TOKEN=

# Public origin of the dashboard (v0.17) — when set, scheduled captions carry
# a correction permalink: <origin>/offers/<id> (master plan §11). It is also
# added to the API's CORS allowlist automatically.
# MTK_PUBLIC_BASE_URL=

# Browser origins allowed to call the API (comma separated). Defaults to the
# local dashboard origins; add your deployed dashboard origin here (v0.20).
# MTK_CORS_ORIGINS=https://radar.yourdomain.tld

# Monitor notifications (optional). The monitor always logs alerts; these
# settings add an outbound webhook and/or an SMTP email digest. See
# docs/notifications.md. Leave both channels blank to keep logging only.
#
# Outbound webhook: JSON POST, schema mtk-radar.notification.v1. The token is
# sent as "Authorization: Bearer <token>"; use a long random value and verify
# it in your receiver (or rely on a secret webhook URL).
# MTK_NOTIFY_WEBHOOK_URL=
# MTK_NOTIFY_WEBHOOK_TOKEN=
#
# Email digest over SMTP. For Gmail use an App Password (2-Step Verification
# required), not your normal account password. Port 587 uses STARTTLS; port
# 465 uses implicit SSL automatically.
# MTK_NOTIFY_EMAIL_TO=
# MTK_SMTP_HOST=smtp.gmail.com
# MTK_SMTP_PORT=587
# MTK_SMTP_USER=
# MTK_SMTP_PASSWORD=
# MTK_SMTP_FROM=
# MTK_SMTP_STARTTLS=1
# MTK_SMTP_SSL=0
# MTK_NOTIFY_TIMEOUT_S=10
# Suppress an identical alert digest for this many seconds after successful
# delivery (default 1 hour); 0 disables the cooldown. Cooldown is in-memory.
# MTK_NOTIFY_COOLDOWN_S=3600
# MTK_NOTIFY_SUBJECT_PREFIX=[MTK RADAR]
